{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "api-clients/**/*.ts",
    "fixtures/**/*.ts",
    "types/api/**/*.ts",
    "types/ui/**/*.ts",
    "test-data/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
